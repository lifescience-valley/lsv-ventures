---
import { Image } from 'astro:assets';
import { company, portfolioData } from '../../data/site';
import { getLang, useTranslations } from '../../i18n';

const t = useTranslations(getLang(Astro.currentLocale)).portfolio;
const portfolio = portfolioData.map((p, i) => ({ ...p, sector: t.sectors[i] ?? '' }));
---

<section class="portfolio section" id="portfolio">
  <div class="container">
    <h2 class="title">{t.title}</h2>

    <ul class="portfolio-grid">
      {
        portfolio.map((item) => (
          <li class="company">
            <div class="deco-frame company-image">
              <Image src={item.image} alt={item.name} width={320} height={320} fit="cover" />
            </div>
            <h3>{item.name}</h3>
            <p>{item.sector}</p>
          </li>
        ))
      }
    </ul>

    <div class="join">
      <h2 class="title">{t.joinTitle}</h2>
      {t.joinParagraphs.map((p) => <p>{p}</p>)}
      <p>{t.contactLead} <a href={`mailto:${company.email}`}>{company.email}</a>.</p>
    </div>
  </div>
</section>

<style>
  .title {
    color: var(--petrol);
    font-size: var(--fs-h2);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(3rem, 5vw, 4rem) 2rem;
    margin: 0 0 clamp(4rem, 8vw, 6rem);
    padding: 0;
    list-style: none;
  }

  .company {
    text-align: center;
  }

  .company-image {
    width: min(240px, 75%);
    margin: 0 auto 1.75rem;
  }

  .company-image :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--white);
  }

  .company h3 {
    margin: 0 0 0.15rem;
    color: var(--green);
    font-size: 1.3125rem;
    font-weight: 600;
  }

  .company p {
    margin: 0;
    font-size: 0.875rem;
  }

  .join .title {
    margin-bottom: 1.5rem;
  }

  .join p {
    font-size: 0.9375rem;
  }

  .join a {
    color: var(--green);
  }

  @media (max-width: 900px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
