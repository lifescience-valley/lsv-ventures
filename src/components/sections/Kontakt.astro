---
import Icon from '../Icon.astro';
import { company } from '../../data/site';
import { getLang, useTranslations } from '../../i18n';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).contact;
const mailto = `mailto:${company.email}?subject=${encodeURIComponent(t.mailSubject)}`;
---

<section class="contact section bg-petrol" id="kontakt">
  <div class="container contact-grid">
    <div>
      <h2>{t.title}</h2>
      <p>{t.text}</p>
      <address>
        {company.name}<br />
        {company.street}<br />
        {company.zipCity}
        {lang !== 'de' && (<><br />{company.country[lang]}</>)}
      </address>
    </div>

    <div class="contact-card">
      <h3>{t.cardTitle}</h3>
      <p>{t.cardText}</p>
      <a class="btn" href={mailto}>
        <Icon name="mail" />
        {t.button}
      </a>
      <ul class="contact-lines">
        <li>
          <Icon name="mail" size={20} />
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </li>
        <li>
          <Icon name="phone" size={20} />
          <a href={`tel:${company.phoneIntl}`}>
            {t.phoneLabel} {lang === 'de' ? company.phone : company.phoneIntlDisplay}
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .contact h2 {
    font-size: var(--fs-h2);
  }

  .contact p {
    font-size: 0.9375rem;
  }

  address {
    margin-top: 2.5rem;
    font-style: normal;
    font-size: 0.9375rem;
  }

  .contact-card {
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border: 1px solid rgba(19, 233, 161, 0.5);
    background: rgba(255, 255, 255, 0.04);
  }

  .contact-card h3 {
    color: var(--mint);
    font-size: var(--fs-h3);
  }

  .contact-card .btn {
    margin: 0.5rem 0 1.75rem;
  }

  .contact-lines {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-lines li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .contact-lines :global(svg) {
    color: var(--mint);
    flex: none;
  }

  .contact-lines a {
    text-decoration: none;
  }

  .contact-lines a:hover {
    color: var(--mint);
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
