---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/hero-pflanze.jpg';
import overlay from '../../assets/images/brand/overlay-intro.svg';
import Icon from '../Icon.astro';
import { getLang, useTranslations } from '../../i18n';

const t = useTranslations(getLang(Astro.currentLocale)).hero;
---

<section class="hero bg-petrol" id="start">
  <div class="container hero-grid">
    <div class="hero-text">
      <h1>{t.title}</h1>
      <h2>{t.subtitle}</h2>
      {t.paragraphs.map((p) => <p>{p}</p>)}
      <a class="btn" href="#fonds">{t.cta} <Icon name="arrow" /></a>
    </div>

    <div class="hero-media">
      <Image
        src={heroImage}
        alt={t.imageAlt}
        widths={[480, 800, 1200]}
        sizes="(max-width: 900px) 100vw, 50vw"
        loading="eager"
        fetchpriority="high"
      />
      <Image src={overlay} alt="" class="hero-overlay" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 6vw, 72px) 0;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: stretch;
  }

  .hero-text {
    padding-bottom: clamp(40px, 6vw, 72px);
    font-size: 0.9375rem;
  }

  .hero-text h1 {
    color: var(--mint);
    font-size: var(--fs-display);
  }

  .hero-text h2 {
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.4375rem);
    margin-bottom: 1.2em;
  }

  .hero-text .btn {
    margin-top: 0.75rem;
  }

  .hero-media {
    position: relative;
    min-height: 420px;
  }

  .hero-media > :global(img:first-child) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Petrol-Overlay mit Pixelraster wie im Original: schneidet das Bild rechts unten treppenförmig an */
  .hero-media :global(.hero-overlay) {
    position: absolute;
    left: 50%;
    bottom: -1px;
    width: 76%;
    max-width: none;
    height: auto;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-media {
      min-height: 300px;
      margin-inline: calc(-1 * var(--gutter));
    }
  }
</style>
