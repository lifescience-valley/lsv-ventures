---
import { getLang, useTranslations } from '../../i18n';

const t = useTranslations(getLang(Astro.currentLocale)).news;
---

<section class="news section bg-petrol" id="neuigkeiten">
  <div class="container">
    <h2>{t.title}</h2>
    <ul class="news-list">
      {
        t.items.map((item) => (
          <li class="news-item">
            <p class="news-date">{item.date}</p>
            <h3>{item.title}</h3>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .news h2 {
    font-size: var(--fs-h2);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .news-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .news-item {
    padding: 0.5rem clamp(1.25rem, 3vw, 2.5rem);
    border-left: 1px solid rgba(19, 233, 161, 0.6);
  }

  .news-item:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .news-date {
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--mint);
  }

  .news-item h3 {
    margin: 0;
    font-size: var(--fs-h3);
    line-height: 1.3;
  }

  @media (max-width: 900px) {
    .news-list {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .news-item,
    .news-item:first-child {
      padding: 0 0 0 1.25rem;
      border-left: 2px solid var(--mint);
    }
  }
</style>
