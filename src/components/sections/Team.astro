---
import { Image } from 'astro:assets';
import { teamData } from '../../data/site';
import { getLang, useTranslations } from '../../i18n';

const t = useTranslations(getLang(Astro.currentLocale)).team;
const team = teamData.map((p, i) => ({ ...p, ...t.members[i]! }));
---

<section class="team section bg-mint" id="team">
  <div class="container">
    <header class="team-head">
      <h2>{t.title}</h2>
      {t.paragraphs.map((p) => <p>{p}</p>)}
    </header>

    <ul class="team-grid">
      {
        team.map((person) => (
          <li class="person">
            <div class="deco-frame person-photo">
              <Image src={person.image} alt={`${t.portraitAlt} ${person.name}`} width={240} height={240} fit="cover" />
            </div>
            <h3>{person.name}</h3>
            <p class="role">{person.role}</p>
            <p class="focus">{person.focus}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .team-head {
    max-width: 960px;
    margin: 0 auto clamp(3rem, 6vw, 4.5rem);
    text-align: center;
    font-size: 0.9375rem;
  }

  .team-head h2 {
    color: var(--petrol);
    font-size: var(--fs-h2);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 6vw, 4.5rem) 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .person {
    text-align: center;
  }

  .person-photo {
    width: min(240px, 70%);
    margin: 0 auto 1.75rem;
  }

  .person-photo :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(1);
  }

  .person h3 {
    margin: 0 0 0.15rem;
    color: var(--green);
    font-size: 1.3125rem;
    font-weight: 600;
  }

  .role {
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
  }

  .focus {
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
