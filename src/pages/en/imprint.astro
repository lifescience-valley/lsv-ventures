---
import LegalLayout from '../../layouts/LegalLayout.astro';
import { company } from '../../data/site';
---

<LegalLayout title="Legal Notice" route="imprint">
  <h1>Legal Notice</h1>

  <p class="legal-note">
    This is a translation provided for convenience. Only the <a href="/impressum" hreflang="de">German version</a> is
    legally binding.
  </p>

  <p>
    <strong>{company.name}</strong><br />
    {company.street}<br />
    {company.zipCity}<br />
    {company.country.en}
  </p>

  <p>
    Commercial register: 206825<br />
    Register court: Amtsgericht Göttingen (Local Court of Göttingen)
  </p>

  <p>
    <strong>Represented by the Managing Directors:</strong><br />
    Marco Janezic<br />
    Sven Wagner
  </p>

  <h2>Contact</h2>
  <p>
    Phone: <a href={`tel:${company.phoneIntl}`}>{company.phoneIntlDisplay}</a><br />
    Email: <a href={`mailto:${company.email}`}>{company.email}</a>
  </p>

  <h2>VAT ID</h2>
  <p>
    VAT identification number pursuant to Section 27a of the German VAT Act (UStG):<br />
    The VAT ID has been applied for and will be provided once issued.
  </p>

  <h2>Responsible for editorial content</h2>
  <p>
    Ms Naomi Kramer<br />
    {company.street}<br />
    {company.zipCity}<br />
    {company.country.en}
  </p>

  <h2>Consumer dispute resolution</h2>
  <p>We are neither willing nor obliged to participate in dispute resolution proceedings before a consumer arbitration board.</p>

  <h2>Key information document</h2>
  <p>The key information document (Basis-Informationsblatt) is available in German only.</p>
  <p>
    <a class="btn" href="/downloads/LSVVM-Basisinformationsblatt.pdf" download hreflang="de">Download (PDF, German)</a>
  </p>
</LegalLayout>

<style>
  .btn {
    color: var(--petrol) !important;
  }

  .btn:hover {
    background: var(--petrol);
    color: var(--white) !important;
  }
</style>
