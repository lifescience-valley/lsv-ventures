---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang, languages, routes, useTranslations, withBase, type Lang, type PagePaths, type RouteKey } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  /** Welche Seite das ist – für Sprachumschalter und hreflang-Links */
  route?: RouteKey;
  /** Alternativ: URLs je Sprache direkt angeben (z. B. für News- und Portfolio-Seiten) */
  paths?: PagePaths;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).meta;
const { title, description = t.description, route = 'home', paths } = Astro.props;
const pagePaths: PagePaths = paths ?? routes[route];
const pageTitle = `${title ?? t.homeTitle} – ${t.siteName}`;
// hreflang nur für Sprachen, in denen die Seite tatsächlich existiert
const alternates = (Object.keys(languages) as Lang[]).flatMap((l) => {
  const href = pagePaths[l];
  return href ? [{ lang: l, href }] : [];
});
// Vorschau-Schutz: Suchmaschinen sollen die Seite nicht indexieren, bis ALLOW_INDEXING=true gesetzt ist.
const noindex = process.env.ALLOW_INDEXING !== 'true';
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#006964" />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site ?? Astro.url).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pagePaths.de, Astro.site ?? Astro.url).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">{t.skipLink}</a>
    <Header paths={pagePaths} />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
  </body>
</html>
