---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLang, languages, routes, useTranslations, type Lang, type RouteKey } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  /** Welche Seite das ist – für Sprachumschalter und hreflang-Links */
  route: RouteKey;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang).meta;
const { title, description = t.description, route } = Astro.props;
const pageTitle = `${title ?? t.homeTitle} – ${t.siteName}`;
// hreflang nur für Sprachen, in denen die Seite tatsächlich existiert
const alternates = (Object.keys(languages) as Lang[]).flatMap((l) => {
  const href = routes[route][l];
  return href ? [{ lang: l, href }] : [];
});
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#006964" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site ?? Astro.url).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(routes[route].de, Astro.site ?? Astro.url).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">{t.skipLink}</a>
    <Header route={route} />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
  </body>
</html>
